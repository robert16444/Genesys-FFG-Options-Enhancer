<form class="grr-form">
  <h3>{{grr_localize 'request.onlinePlayers'}}</h3>
  <div class="grr-userlist">
    {{#each onlineUsers}}
      <div class="grr-user {{#unless hasActor}}grr-disabled{{/unless}}" data-user-id="{{id}}" data-actor-id="{{actorId}}">
        <img class="grr-avatar" src="{{actorImg}}" />
        <div class="grr-userinfo">
          <div class="grr-username">{{name}}</div>
          <div class="grr-actorname">{{actorName}}</div>
        </div>
      </div>
    {{/each}}
    {{#unless onlineUsers.length}}
      <p class="grr-muted">{{grr_localize 'request.noOnlinePlayers'}}</p>
    {{/unless}}
  </div>

  <hr/>

  <div class="grr-field">
    <label>{{grr_localize 'request.label'}}</label>
    <input type="text" name="label" placeholder="{{grr_localize 'request.labelPlaceholder'}}" />
  </div>

  <div class="grr-field">
    <label>{{grr_localize 'request.skill'}}</label>
    <input type="hidden" name="skillKey" value="" />
    <input type="hidden" name="skillLabel" value="" />
    <div class="grr-row grr-row-top">
      <div class="grr-skill-list" data-skill-list>
        {{#each initialSkills}}
          <button type="button" class="grr-skill-option" data-skill-key="{{key}}" data-skill-label="{{label}}">{{label}}</button>
        {{/each}}
        {{#unless initialSkills.length}}
          <div class="grr-muted">{{grr_localize 'request.noSkillsFound'}}</div>
        {{/unless}}
      </div>
      <button type="button" name="refreshSkills" class="grr-btn" title="{{grr_localize 'request.refreshSkills'}}">↻</button>
    </div>
    <p class="grr-muted">{{grr_localize 'request.skillHint'}}</p>
  </div>

  <section class="grr-dice-builder">
    <div class="grr-field grr-difficulty-field">
      <label>{{grr_localize 'request.difficulty'}}</label>
      <input type="hidden" name="difficulty" value="0" />
      <div class="grr-difficulty-selector" title="{{grr_localize 'request.difficultyHint'}}">
        <button type="button" class="grr-difficulty-die" data-value="1" aria-label="1"><span class="grr-die grr-die-difficulty"></span></button>
        <button type="button" class="grr-difficulty-die" data-value="2" aria-label="2"><span class="grr-die grr-die-difficulty"></span></button>
        <button type="button" class="grr-difficulty-die" data-value="3" aria-label="3"><span class="grr-die grr-die-difficulty"></span></button>
        <button type="button" class="grr-difficulty-die" data-value="4" aria-label="4"><span class="grr-die grr-die-difficulty"></span></button>
        <button type="button" class="grr-difficulty-die" data-value="5" aria-label="5"><span class="grr-die grr-die-difficulty"></span></button>
      </div>
    </div>

    <div class="grr-modifier-grid">
      <div class="grr-field grr-stepper-field">
        <label>{{grr_localize 'request.challengeUpgrades'}}</label>
        <input type="hidden" name="challenge" value="0" />
        <div class="grr-stepper">
          <button type="button" class="grr-stepper-btn" data-input="challenge" data-delta="-1">−</button>
          <output data-stepper-value="challenge">0</output>
          <button type="button" class="grr-stepper-btn" data-input="challenge" data-delta="1">+</button>
        </div>
      </div>

      <div class="grr-field grr-stepper-field">
        <label>{{grr_localize 'request.boost'}}</label>
        <input type="hidden" name="boost" value="0" />
        <div class="grr-stepper">
          <button type="button" class="grr-stepper-btn" data-input="boost" data-delta="-1">−</button>
          <output data-stepper-value="boost">0</output>
          <button type="button" class="grr-stepper-btn" data-input="boost" data-delta="1">+</button>
        </div>
      </div>

      <div class="grr-field grr-stepper-field">
        <label>{{grr_localize 'request.setback'}}</label>
        <input type="hidden" name="setback" value="0" />
        <div class="grr-stepper">
          <button type="button" class="grr-stepper-btn" data-input="setback" data-delta="-1">−</button>
          <output data-stepper-value="setback">0</output>
          <button type="button" class="grr-stepper-btn" data-input="setback" data-delta="1">+</button>
        </div>
      </div>
    </div>

    <div class="grr-final-difficulty-block">
      <span class="grr-small-label">{{grr_localize 'request.finalDifficulty'}}</span>
      <div class="grr-final-difficulty" data-final-difficulty></div>
    </div>
  </section>

  <section class="grr-roll-preview-block">
    <div class="grr-preview-header">
      <label>{{grr_localize 'request.rollPreview'}}</label>
      <span class="grr-muted">{{grr_localize 'request.rollPreviewHint'}}</span>
    </div>
    <div class="grr-roll-preview" data-roll-preview></div>
  </section>

  <div class="grr-field">
    <label>{{grr_localize 'request.rollMode'}}</label>
    <select name="rollMode">
      {{#each rollModes}}
        <option value="{{id}}">{{label}}</option>
      {{/each}}
    </select>
  </div>

  <div class="grr-actions">
    <button type="button" name="send" class="grr-primary"><i class="fas fa-paper-plane"></i> {{grr_localize 'request.send'}}</button>
  </div>
</form>
